rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * The site operator. Read-only on purpose: the point is oversight of what
     * has been published here, not the ability to edit someone else's manual.
     * Because this does not depend on resource.data, it also lets the operator
     * list every manual without a filter.
     */
    function isAdmin() {
      return isSignedIn()
             && request.auth.token.email_verified == true
             && request.auth.token.email == 'totoriverce@gmail.com';
    }

    match /spaces/{spaceId} {

      function space() {
        return get(/databases/$(database)/documents/spaces/$(spaceId)).data;
      }

      // The owner, plus anyone whose signed-in email was invited as an editor.
      function canEdit(data) {
        return isSignedIn() && (
          request.auth.uid == data.ownerId ||
          (request.auth.token.email != null &&
           request.auth.token.email in data.get('editorEmails', []))
        );
      }

      function canRead(data) {
        return data.visibility == 'public' || canEdit(data) || isAdmin();
      }

      allow read: if canRead(resource.data);

      // The document ID is the slug, so the two must agree.
      allow create: if isSignedIn()
                    && request.auth.uid == request.resource.data.ownerId
                    && request.resource.data.slug == spaceId
                    && request.resource.data.visibility in ['public', 'private'];

      // Ownership and address are fixed for the life of a document; changing an
      // address is a move to a new document, not an update.
      allow update: if canEdit(resource.data)
                    && request.resource.data.ownerId == resource.data.ownerId
                    && request.resource.data.slug == resource.data.slug
                    // Only the owner may change who else can edit.
                    && (request.resource.data.get('editorEmails', []) ==
                        resource.data.get('editorEmails', []) ||
                        request.auth.uid == resource.data.ownerId);

      allow delete: if isSignedIn() && request.auth.uid == resource.data.ownerId;

      // --- Published documents ------------------------------------------
      // Readers may only list published pages. A query without
      // `published == true` is rejected unless the caller can edit.
      match /pages/{pageId} {
        allow read: if (space().visibility == 'public' && resource.data.published == true)
                    || canEdit(space())
                    || isAdmin();
        allow write: if canEdit(space());
      }

      // --- Working copies -----------------------------------------------
      // Never readable by the public; this is where unpublished text lives.
      match /drafts/{pageId} {
        allow read: if canEdit(space()) || isAdmin();
        allow write: if canEdit(space());
      }

      // --- Publish history ----------------------------------------------
      match /versions/{versionId} {
        allow read: if canEdit(space()) || isAdmin();
        allow create: if canEdit(space());
        allow delete: if canEdit(space());
      }

      // --- Reader feedback ----------------------------------------------
      // Anyone reading a public manual may leave one; only editors can read
      // the results back.
      match /feedback/{feedbackId} {
        allow create: if space().visibility == 'public'
                      && request.resource.data.helpful is bool
                      && request.resource.data.comment is string
                      && request.resource.data.comment.size() <= 1000;
        allow read: if canEdit(space()) || isAdmin();
        allow delete: if canEdit(space());
      }
    }
  }
}
