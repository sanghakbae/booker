rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Images embedded in a manual are served publicly; only the space owner
    // can upload, and uploads are capped at 10MB.
    match /spaces/{spaceId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && firestore.get(/databases/(default)/documents/spaces/$(spaceId)).data.ownerId == request.auth.uid
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
